APP_NAME=Gilas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gilas
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Replace blanks with the restaurant's actual details.
GILAS_RESTAURANT_NAME="گیلاس"
GILAS_RESTAURANT_SLUG=gilas
GILAS_RESTAURANT_DESCRIPTION=
GILAS_RESTAURANT_LOGO_PATH=
GILAS_RESTAURANT_COVER_IMAGE_PATH=
GILAS_RESTAURANT_PHONE=
GILAS_RESTAURANT_EMAIL=
GILAS_RESTAURANT_ADDRESS=
GILAS_RESTAURANT_LATITUDE=
GILAS_RESTAURANT_LONGITUDE=
GILAS_RESTAURANT_TIMEZONE=Asia/Tehran
GILAS_RESTAURANT_CURRENCY=IRR

# Optional: set all three only if creating the first owner account.
# Keep the real password in .env and never commit it.
GILAS_OWNER_NAME=
GILAS_OWNER_EMAIL=
GILAS_OWNER_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@gilas.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
